{
  "expo": {
    "name": "VetPaw - AI Dog Care",
    "slug": "vetpaw-ai-dog-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vetpaw",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VetPaw needs camera access to take photos of your pet for AI analysis",
        "NSMicrophoneUsageDescription": "VetPaw needs microphone access for voice input and pet sound analysis",
        "NSPhotoLibraryUsageDescription": "VetPaw needs photo library access to select pet images for AI analysis"
      },
      "bundleIdentifier": "com.naveedahmedswe.vetpawaidogcare",
      "associatedDomains": ["applinks:vetpaw-ai-dog-care.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Vet Paw app icon.png",
        "backgroundColor": "#FFF8E1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.vending.BILLING"
      ],
      "package": "com.naveedahmedswe.vetpawaidogcare",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "vetpaw",
              "host": "auth-callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "VetPaw needs access to your photo library to select pet images for AI analysis",
          "cameraPermission": "VetPaw needs camera access to take photos of your pet for AI analysis"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "VetPaw needs microphone access for voice input and pet sound analysis"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9a64ae34-2d8e-4dc7-b562-897bf5eac941"
      }
    },
    "owner": "vetpaw",
    "splash": {
      "image": "./assets/images/splash screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E1"
    }
  }
}