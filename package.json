{
  "name": "vetpaw-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "start:web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "reset-cache": "expo start --clear && npm run clear-metro",
    "clear-metro": "npx react-native start --reset-cache",
    "optimize": "npm run reset-cache && npm run start",
    "build:web": "expo export --platform web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "preview": "expo start --clear",
    "test": "jest",
    "lint": "expo lint",
    "clean": "rm -rf node_modules && npm cache clean --force && npm install"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~53.0.0",
    "expo-av": "~15.1.6",
    "expo-blur": "~14.1.3",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-document-picker": "~13.1.5",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.3",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.3",
    "expo-linking": "~7.1.3",
    "expo-media-library": "~17.1.7",
    "expo-router": "~5.1.0",
    "expo-speech": "~13.1.7",
    "expo-splash-screen": "~0.30.6",
    "expo-status-bar": "~2.2.2",
    "expo-symbols": "~0.4.3",
    "expo-system-ui": "~5.0.5",
    "expo-updates": "^0.28.14",
    "expo-web-browser": "~14.1.5",
    "lucide-react-native": "^0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^8.11.4",
    "react-native-purchases-ui": "^8.11.4",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "expo-dev-client": "~5.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-config": "^0.20.14",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "metro-minify-terser": "^0.82.4",
    "react-native-dotenv": "^3.4.11",
    "supabase": "^2.26.9",
    "typescript": "~5.8.3"
  }
